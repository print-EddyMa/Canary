{"themes":[{"id":"heat","name":"Heat","about":"How warm the air and ground are, and how often it freezes."},{"id":"water","name":"Water","about":"Rain, moisture in the air and soil, and evaporation."},{"id":"ice","name":"Snow and ice","about":"Snowfall, snow on the ground and ice on the sea."},{"id":"sky","name":"Air and sky","about":"Sunlight, cloud, haze, ozone and how reflective the surface is."},{"id":"wind","name":"Wind and pressure","about":"How hard the wind blows and the weight of the air."}],"families":{"thermal":{"name":"Thermal","a":"cooler","b":"warmer"},"water":{"name":"Water","a":"drier","b":"wetter"},"air":{"name":"Air","a":"more in the air","b":"more sun and wind"}},"variables":[{"id":"temperature","label":"Air temperature","unit":"\u00b0C","theme":"heat","definition":"Average air temperature two metres above the ground.","source":"NASA POWER (MERRA-2 reanalysis)","parameter":"T2M","ready":true,"family":"thermal","up":"b","record_from":1981},{"id":"temperature_max","label":"Hottest temperature of the year","unit":"\u00b0C","theme":"heat","definition":"The highest air temperature reached during the year.","source":"NASA POWER (MERRA-2 reanalysis)","parameter":"T2M_MAX","ready":true,"family":"thermal","up":"b","record_from":1981},{"id":"temperature_min","label":"Coldest temperature of the year","unit":"\u00b0C","theme":"heat","definition":"The lowest air temperature reached during the year.","source":"NASA POWER (MERRA-2 reanalysis)","parameter":"T2M_MIN","ready":true,"family":"thermal","up":"b","record_from":1981},{"id":"ground_temperature","label":"Ground temperature","unit":"\u00b0C","theme":"heat","definition":"Temperature of the surface itself (soil, rock, water or ice), which is hotter than the air on sunny days.","source":"NASA POWER (MERRA-2 reanalysis)","parameter":"TS","ready":true,"family":"thermal","up":"b","record_from":1981},{"id":"frost_days","label":"Frost days","unit":"days","theme":"heat","definition":"Number of days in the year when 